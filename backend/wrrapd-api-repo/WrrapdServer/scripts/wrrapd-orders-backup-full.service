[Unit]
Description=Wrrapd daily full orders/data backup to GCS
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=admin_
Group=admin_
WorkingDirectory=/home/phill/wrrapd-GCP/backend/wrrapd-api-repo/WrrapdServer
Environment=HOME=/home/admin_
Environment=CLOUDSDK_CONFIG=/home/admin_/.config/gcloud
ExecStart=/home/phill/wrrapd-GCP/backend/wrrapd-api-repo/WrrapdServer/scripts/backup-orders.sh full
StandardOutput=append:/home/phill/wrrapd-GCP/backend/wrrapd-api-repo/WrrapdServer/logs/backup.log
StandardError=append:/home/phill/wrrapd-GCP/backend/wrrapd-api-repo/WrrapdServer/logs/backup.log
Nice=10

[Install]
WantedBy=multi-user.target
