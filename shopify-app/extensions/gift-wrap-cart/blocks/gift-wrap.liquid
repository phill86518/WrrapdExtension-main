{% comment %}
  Wrrapd Inc. — cart gift-wrap opt-in block.
  Support: help@wrrapd.com
{% endcomment %}
<div class="wrrapd-cart-wrap" data-wrrapd-cart-wrap>
  <label class="wrrapd-cart-wrap__label">
    <input
      type="checkbox"
      name="attributes[_wrrapd_wrap]"
      value="1"
      {% if cart.attributes._wrrapd_wrap == '1' %}checked{% endif %}
      form="{{ block.settings.cart_form_id | default: 'cart' }}"
    >
    <span>Gift wrap &amp; deliver with Wrrapd</span>
  </label>
  <p class="wrrapd-cart-wrap__hint">
    Wrrapd Inc. wraps your gift and delivers it. Your store ships the items to our hub.
  </p>
</div>

{% schema %}
{
  "name": "Wrrapd gift wrap",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "cart_form_id",
      "label": "Cart form id",
      "default": "cart"
    }
  ]
}
{% endschema %}
