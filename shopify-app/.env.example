# Wrrapd Inc. Shopify app — never commit real secrets
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products,read_orders,write_orders,read_shipping,write_shipping,read_checkouts,write_checkouts,write_order_edits
SHOPIFY_APP_URL=https://REPLACE_TUNNEL_OR_HOST

# Forward verified Shopify orders to the Wrrapd pay server
WRRAPD_API_BASE=https://api.wrrapd.com
SHOPIFY_WRRAPD_WEBHOOK_SECRET=

# Support shown in merchant admin (must stay Wrrapd Inc.)
WRRAPD_SUPPORT_EMAIL=help@wrrapd.com
WRRAPD_LEGAL_NAME=Wrrapd Inc.
WRRAPD_SUPPORT_ADDRESS=7901 4th St N, Ste 300, St. Petersburg, FL 33702
