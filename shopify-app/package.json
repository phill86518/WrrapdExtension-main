{
  "name": "wrrapd-shopify-app",
  "version": "3.0.13",
  "private": true,
  "author": "Wrrapd Inc.",
  "description": "Wrrapd Gift Wrap & Delivery — Shopify app for Wrrapd Inc.",
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
