# Chrome extension — local only. Copy to .env and fill in.
# Do NOT put GA4_API_SECRET in background.js or the Chrome Web Store zip
# (anyone can extract it). The pay server reads the real values and forwards
# heartbeats to GA4. See backend/wrrapd-api-repo/WrrapdServer/.env

# GA4 property → Admin → Data streams → Measurement ID (G-XXXXXXXX)
GA4_MEASUREMENT_ID=

# GA4 property → Admin → Data streams → Measurement Protocol API secrets
GA4_API_SECRET=
